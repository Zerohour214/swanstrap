# swanstrap settings for: sudo ./bootstrap.sh --config my.env
# Every line is optional. Anything left out is auto-detected or uses the default shown.
# Command-line options override this file. Don't put the CA passphrase here
# (use --ca-passphrase-file instead).

# --- Where the server is (default: detected from cloud metadata / geo-IP) ---
#PROVIDER=AWS                 # default VPS
#COUNTRY=DE                   # ISO 3166 two-letter code; default XX
#CITY="Frankfurt"             # default Server
#REGION=eu-central-1          # default unknown
#SERVER_ADDR=203.0.113.20      # public IPv4; detected, no default

# --- Names (default: derived from the values above) ---
#SERVER_ID=aws-de-fra-01      # <provider>-<country>-<city 3 letters>-<nn>
#SERVER_NAME="AWS-PQ Frankfurt"   # shown in the device's VPN list

# --- VPN ---
#POOL=10.20.21.0/24           # client IPv4 pool, must be 10.X.Y.0/24; default next free 10.20.N.0/24
#DNS="1.1.1.1, 9.9.9.9"       # DNS servers given to clients
#FIRST_USER=personal          # first username/password login created
#CLIENT_USER=ubuntu           # owner of ~/vpn-clients; default the user who ran sudo

# --- Install ---
#STRONGSWAN=auto              # auto | package | source | source=6.1.0
#CA_MODE=auto                 # auto (restore if ca/ exists) | restore | new
#OFFLINE=1                    # no internet lookups for IP / location
